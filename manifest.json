{
  "manifest_version": 3,
  "name": "tabFx",
  "version": "1.3.1",

  "description": "Search and auto filter similar tabs in a fast way",
  "homepage_url": "https://github.com/2alin/tabFx",
  "icons": {
      "16": "icons/icon-16px.png",
      "24": "icons/icon-24px.png",
      "32": "icons/icon-32px.png",
      "48": "icons/icon-48px.png",
      "128": "icons/icon-128px.png"
    },

  "permissions": [
    "tabs",
    "storage"
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon-16px.png",
      "24": "icons/icon-24px.png",
      "32": "icons/icon-32px.png",
      "48": "icons/icon-48px.png",
      "128": "icons/icon-128px.png"
    },
    "default_title": "tabFx",
    "default_popup": "popup/main.html"
  }

}